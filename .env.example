# Copia este archivo a ".env" y llena tus valores.
# Los obtienes en https://developer.spotify.com/dashboard después de crear una app.

SPOTIFY_CLIENT_ID=tu_client_id_aqui
SPOTIFY_CLIENT_SECRET=tu_client_secret_aqui

# Debe coincidir EXACTAMENTE con la Redirect URI que registres en el dashboard de Spotify
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/callback

# Opcional: dónde guardar el token de acceso ya autorizado
SPOTIFY_CACHE_PATH=.spotify_token_cache
